[Unit]
Description=CELLS Account identity service
Documentation=https://CELLS.tech/docs/#/CELLS-account
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CELLS
Group=CELLS
EnvironmentFile=/etc/CELLS/account.conf
ExecStart=/opt/CELLS/CELLS-account
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=CELLS-account
StateDirectoryMode=0750
ReadWritePaths=/var/lib/CELLS-account
UMask=0077

[Install]
WantedBy=multi-user.target
