{
  "name": "CELLS-sdk",
  "version": "0.5.0",
  "description": "Official JavaScript / Node.js SDK for the CELLS HTTP API (native coin: Cell / CELL). Feature parity with sdk/go.",
  "main": "CELLS.js",
  "types": "CELLS.d.ts",
  "exports": {
    ".": {
      "types": "./CELLS.d.ts",
      "require": "./CELLS.js",
      "default": "./CELLS.js"
    },
    "./cell-stream-runtime": {
      "types": "./cell-stream-runtime.d.ts",
      "require": "./cell-stream-runtime.js",
      "default": "./cell-stream-runtime.js"
    }
  },
  "scripts": {
    "test": "node --test CELLS.test.js CELLS20.test.js cell-stream-runtime.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "CELLS",
    "cell",
    "blockchain",
    "quantum-safe",
    "post-quantum",
    "ml-dsa",
    "dilithium",
    "ledger",
    "sdk",
    "client"
  ],
  "author": "CELLS authors",
  "license": "MIT",
  "homepage": "https://CELLS.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackbeardONE/CELLS.git",
    "directory": "CELLS/source/sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/blackbeardONE/CELLS/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "CELLS.js",
    "CELLS.d.ts",
    "cell-stream-runtime.js",
    "cell-stream-runtime.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
